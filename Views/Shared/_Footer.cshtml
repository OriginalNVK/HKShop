 <!-- FOOTER -->
<footer id="footer">
	<!-- top footer -->
	<div class="section">
		<!-- container -->
		<div class="container">
			<!-- row -->
			<div class="row">
				<div class="col-md-3 col-xs-6">
					<div class="footer">
						<h3 class="footer-title">@UIConstants.Footer.AboutUs</h3>
						<p>@UIConstants.Footer.AboutDescription</p>
						<ul class="footer-links">
							@await Html.PartialAsync("_ContactInfoLinks")
						</ul>
					</div>
				</div>

				<div class="col-md-3 col-xs-6">
					<div class="footer">
						<h3 class="footer-title">@UIConstants.Footer.Categories</h3>
						<ul class="footer-links">
							@foreach (var link in UIConstants.FooterCategoryLinks)
							{
								<li><a href="@link.Href">@link.Text</a></li>
							}
						</ul>
					</div>
				</div>

				<div class="clearfix visible-xs"></div>

				<div class="col-md-3 col-xs-6">
					<div class="footer">
						<h3 class="footer-title">@UIConstants.Footer.Information</h3>
						<ul class="footer-links">
							@foreach (var link in UIConstants.FooterInformationLinks)
							{
								<li><a href="@link.Href">@link.Text</a></li>
							}
						</ul>
					</div>
				</div>

				<div class="col-md-3 col-xs-6">
					<div class="footer">
						<h3 class="footer-title">@UIConstants.Footer.Services</h3>
						<ul class="footer-links">
							@foreach (var link in UIConstants.FooterServiceLinks)
							{
								<li><a href="@link.Href">@link.Text</a></li>
							}
						</ul>
					</div>
				</div>
			</div>
			<!-- /row -->
		</div>
		<!-- /container -->
	</div>
	<!-- /top footer -->
	<!-- bottom footer -->
	<div id="bottom-footer" class="section">
		<div class="container">
			<!-- row -->
			<div class="row">
				<div class="col-md-12 text-center">
					<ul class="footer-payments">
						<li><a href="#"><i class="fa fa-cc-visa"></i></a></li>
						<li><a href="#"><i class="fa fa-credit-card"></i></a></li>
						<li><a href="#"><i class="fa fa-cc-paypal"></i></a></li>
						<li><a href="#"><i class="fa fa-cc-mastercard"></i></a></li>
						<li><a href="#"><i class="fa fa-cc-discover"></i></a></li>
						<li><a href="#"><i class="fa fa-cc-amex"></i></a></li>
					</ul>
					<span class="copyright">
						<!-- Link back to Colorlib can't be removed. Template is licensed under CC BY 3.0. -->
						Copyright &copy; @DateTime.Now.Year All rights reserved | Website made with <i class="fa fa-heart-o" aria-hidden="true" style="color:#ff6b6b;"></i> by <a href="https://colorlib.com" target="_blank" style="color:#00c2a8;font-weight:600;">Original NVK</a>
						<!-- Link back to Colorlib can't be removed. Template is licensed under CC BY 3.0. -->
					</span>

				</div>
			</div>
			<!-- /row -->
		</div>
		<!-- /container -->
	</div>
	<!-- /bottom footer -->

</footer>
<!-- /FOOTER -->