@model IEnumerable<HKShop.DTOs.CategoryMenuDto>
<form class="flex-center" method="get" asp-controller="Product" asp-action="Index">
    <select class="input-select d-md-none" name="CategoryId">
        <option value="0">Categories</option>
        @foreach(var item in Model)
        {
            <option value="@item.CategoryId">@item.CategoryName</option>
        }
    </select>
    <input type="search" class="input form-control p-3" placeholder="Iphone 17 pro max" aria-describedby="search-icon-1" name="keyword">
    <button type="submit" class="search-btn"><span id="search-icon-1" class="input-group-text p-3">Search</span></button>
</form>