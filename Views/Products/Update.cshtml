@model HKShop.DTOs.ProductsResponse
@{
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    ViewBag.Title = "Update Product";
}

<div class="container-fluid">
    <div class="card shadow mb-4">
        <div class="card-header py-3 pb-4">
            <h2 class="m-0 font-weight-bold text-center">Update Product @Model.TenHh</h2>
        </div>
        <div class="card-body mt-4">
            <form asp-action="Edit">
                <input type="hidden" name="id" value="@ViewContext.RouteData.Values["id"]" />
                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                <input type="hidden" asp-for="MaHh" />

                <div class="form-row">
                    <!-- Cột thông tin chính -->
                    <div class="col-md-6">
                        <div class="form-group form-row">
                            <label class="col-12 col-md-4 col-form-label text-md-left text-start">Product Name</label>
                            <div class="col-12 col-md-8 text-md-right text-end">
                                <input asp-for="TenHh" class="form-control" />
                                <span asp-validation-for="TenHh" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="form-group form-row">
                            <label class="col-12 col-md-4 col-form-label text-md-left text-start">Product Alias</label>
                            <div class="col-12 col-md-8 text-md-right text-end">
                                <input asp-for="TenAlias" class="form-control" />
                                <span asp-validation-for="TenAlias" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="form-group form-row">
                            <label class="col-12 col-md-4 col-form-label text-md-left text-start">Product Category</label>
                            <div class="col-12 col-md-8 text-md-right text-end">
                                <select asp-for="MaLoai" class="form-control" asp-items="ViewBag.MaLoai">
                                    <option value="">-- Select Product Category --</option>
                                </select>
                                <span asp-validation-for="MaLoai" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="form-group form-row">
                            <label class="col-12 col-md-4 col-form-label text-md-left text-start">Unit Description</label>
                            <div class="col-12 col-md-8 text-md-right text-end">
                                <input asp-for="MoTaDonVi" class="form-control" />
                                <span asp-validation-for="MoTaDonVi" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="form-group form-row">
                            <label class="col-12 col-md-4 col-form-label text-md-left text-start">Unit Price</label>
                            <div class="col-12 col-md-8 text-md-right text-end">
                                <div class="input-group d-flex">
                                    <input asp-for="DonGia" class="form-control" type="number" step="0.01" />
                                    <div class="input-group-append">
                                        <span class="input-group-text">$</span>
                                    </div>
                                </div>
                                <span asp-validation-for="DonGia" class="text-danger small"></span>
                            </div>
                        </div>
                    </div>

                    <!-- Cột thông tin phụ -->
                    <div class="col-md-6">
                        <div class="form-group form-row">
                            <label class="col-12 col-md-4 col-form-label text-md-left text-start">Production Date</label>
                            <div class="col-12 col-md-8 text-md-right text-end">
                                <input asp-for="NgaySx" class="form-control" type="date" />
                                <span asp-validation-for="NgaySx" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="form-group form-row">
                            <label class="col-12 col-md-4 col-form-label text-md-left text-start">Discount</label>
                            <div class="col-12 col-md-8 text-md-right text-end">
                                <div class="input-group d-flex">
                                    <input asp-for="GiamGia" class="form-control" type="number" step="0.01" min="0"
                                        max="1" />
                                    <div class="input-group-append">
                                        <span class="input-group-text">%</span>
                                    </div>
                                </div>
                                <span asp-validation-for="GiamGia" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="form-group form-row">
                            <label class="col-12 col-md-4 col-form-label text-md-left text-start">View Count</label>
                            <div class="col-12 col-md-8 text-md-right text-end">
                                <input asp-for="LuotMua" class="form-control" type="number" />
                                <span asp-validation-for="LuotMua" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="form-group form-row">
                            <label class="col-12 col-md-4 col-form-label text-md-left text-start">Product Image</label>
                            <div class="col-12 col-md-8 text-md-right text-end">
                                <div class="custom-file">
                                    <input type="file" class="custom-file-input" id="customFile" name="Hinh">
                                    <label class="custom-file-label" for="customFile">
                                        @(Model.Hinh != null? Model.Hinh : "Select Image...")
                                    </label>
                                </div>
                                <span asp-validation-for="Hinh" class="text-danger small"></span>

                                <div class="mt-2">
                                    @if (Model.Hinh != null)
                                    {
                                        <img src=@Model.Hinh alt="Product Image" class="img-thumbnail"
                                            style="max-height: 150px;">
                                    }
                                    else
                                    {
                                        <div class="img-thumbnail d-flex align-items-center justify-content-center"
                                            style="width: 100%; max-width: 150px; height: 150px; border: 1px solid #c6c4c4; background-color: #f8f9fa;">
                                            <span style="color: #666; font-size: 14px;">150px x 150px</span>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Mô tả sản phẩm -->
                <div class="form-group">
                    <label class="control-label">Description</label>
                    <textarea asp-for="MoTa" class="form-control" rows="5"></textarea>
                    <span asp-validation-for="MoTa" class="text-danger small"></span>
                </div>

                <!-- Nút hành động -->
                <div class="form-group text-center mt-4">
                    <button type="submit" class="btn btn-primary px-4">Save Changes</button>
                    <a asp-action="Products" asp-controller="Admin" class="btn btn-secondary ml-2">Back to List</a>
                </div>
            </form>


        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}