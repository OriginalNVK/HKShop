@model IEnumerable<HKShop.DTOs.CategoryDto>

@{
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    ViewBag.Title = "Category Management";
}
<div class="card">
    <div class="card-header">
        <h4 class="mb-0 text-center" style="font-size: 20px">List of Categories</h4>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-striped table-hover" id="hoaDonTable">
                <thead class="thead-dark">
                    <tr>
                        <th class="text-center">Category ID</th>
                        <th class="text-center">Thumbnail</th>
                        <th class="text-center">Category Name</th>
                        <th class="text-center">Alias Name</th>
                        <th class="text-center">Description</th>
                        <th class="text-center">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="text-center">@item.CategoryId</td>
                            <td class="text-center"><img src=@item.ImageUrl alt=@item.CategoryName width="120" height="110"></td>
                            <td class="text-center">@item.CategoryName</td>
                            <td class="text-center">@item.CategoryAlias</td>
							<td class="text-center">@item.Description</td>
                            <td class="text-center">
                                <div class="btn-group d-flex justify-center gap-2" role="group">
                                                <a asp-action="Delete" asp-controller="Categories" asp-route-id="@item.CategoryId"
                                       class="btn btn-sm btn-delete" title="Delete category">
                                        <i class="fa fa-trash"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('.btn-delete').click(function (e) {
                e.preventDefault(); // Ngăn chặn hành vi mặc định
                var deleteUrl = $(this).attr('href'); // Lấy URL từ thẻ a

                // Hiển thị hộp thoại confirm
                if (confirm('Do you want to delete this category?')) {
                    window.location.href = deleteUrl; // Chuyển hướng nếu đồng ý
                }
            });
        });
    </script>
}