@using HKShop.Helpers
@model IEnumerable<HKShop.DTOs.InvoiceResponse>

@{
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    ViewBag.Title = "Order Management";
}
<div class="card">
    <div class="card-header">
        <h4 class="mb-0 text-center" style="font-size: 20px">Order List</h4>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-striped table-hover" id="hoaDonTable">
                <thead class="thead-dark">
                    <tr>
                        <th>Order ID</th>
                        <th>Creation Date</th>
                        <th>Customer</th>
                        <th>Address</th>
                        <th>Payment Method</th>
                        <th>Shipping Method</th>
                        <th>Status</th>
                        <th>Phone</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.MaHd</td>
                            <td>@item.NgayDat.ToString("dd/MM/yyyy HH:mm")</td>
                            <td>@item.HoTen</td>
                            <td>@item.DiaChi</td>
                            <td>@item.CachThanhToan</td>
                            <td>@item.CachVanChuyen</td>
                            <td>
                                <span class="badge-@item.TrangThai">
                                    @Utils.convertStatus(item.TrangThai)
                                </span>
                            </td>
                            <td>@item.DienThoai</td>
                            <td>
                                <div class="btn-group d-flex justify-center gap-2" role="group">
                                    <a asp-action="Detail" asp-controller="Orders" asp-route-id="@item.MaHd"
                                       class="btn btn-sm btn-info" title="View Details">
                                        <i class="fa fa-eye"></i>
                                    </a>
                                    <a asp-action="Delete" asp-controller="Orders" asp-route-id="@item.MaHd"
                                       class="btn btn-sm btn-delete" title="Delete Order">
                                        <i class="fa fa-trash"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('.btn-delete').click(function (e) {
                e.preventDefault(); // Ngăn chặn hành vi mặc định
                var deleteUrl = $(this).attr('href'); // Lấy URL từ thẻ a

                // Hiển thị hộp thoại confirm
                if (confirm('Are you sure you want to delete this order?')) {
                    window.location.href = deleteUrl; // Chuyển hướng nếu đồng ý
                }
            });
        });
    </script>
}