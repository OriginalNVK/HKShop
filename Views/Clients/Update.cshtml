@model HKShop.DTOs.CustomerResponseDto
@{
	Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
	ViewBag.Title = "Update User Information";
}

<div class="container-fluid">
	<div class="card shadow mb-4">
		<div class="card-header py-3 pb-4">
			<h2 class="m-0 font-weight-bold text-center">User Information</h2>
		</div>
		<div class="card-body mt-4">
			<form asp-action="Edit" asp-controller="Clients" class="form-horizontal" method="post" enctype="multipart/form-data">
				<div class="form-row">
					<!-- Cột bên trái -->
					<div class="col-md-6 col-sm-12">
						<div class="form-group form-row">
							<label class="col-sm-4 col-form-label">Username:</label>
							<div class="col-sm-8">
								<input asp-for="CustomerId" class="form-control" />
								<span asp-validation-for="CustomerId" class="text-danger small"></span>
							</div>
						</div>

						<div class="form-group form-row">
							<label class="col-sm-4 col-form-label">Fullname:</label>
							<div class="col-sm-8">
								<input asp-for="FullName" class="form-control" />
								<span asp-validation-for="FullName" class="text-danger small"></span>
							</div>
						</div>

						<div class="form-group form-row">
							<label class="col-sm-4 col-form-label">Gender:</label>
							<div class="col-sm-8 d-flex align-items-center">
								<div class="form-check form-check-inline">
									<input class="form-check-input" type="radio" asp-for="Gender" value="true" id="gioiTinhNam">
									<label class="form-check-label" for="gioiTinhNam">Male</label>
								</div>
								<div class="form-check form-check-inline">
									<input class="form-check-input" type="radio" asp-for="Gender" value="false" id="gioiTinhNu">
									<label class="form-check-label" for="gioiTinhNu">Female</label>
								</div>
							</div>
							<div class="offset-sm-4 col-sm-8">
								<span asp-validation-for="Gender" class="text-danger small"></span>
							</div>
						</div>

						<div class="form-group form-row">
							<label class="col-sm-4 col-form-label">Phone Number:</label>
							<div class="col-sm-8">
								<input asp-for="PhoneNumber" class="form-control" />
								<span asp-validation-for="PhoneNumber" class="text-danger small"></span>
							</div>
						</div>
					</div>

					<!-- Cột bên phải -->
					<div class="col-md-6 col-sm-12">
						<div class="form-group form-row">
							<label class="col-sm-4 col-form-label">Password:</label>
							<div class="col-sm-8">
								<input asp-for="Password" class="form-control" type="password" />
								<span asp-validation-for="Password" class="text-danger small"></span>
							</div>
						</div>

						<div class="form-group form-row">
							<label class="col-sm-4 col-form-label">Address:</label>
							<div class="col-sm-8">
								<input asp-for="Address" class="form-control" placeholder="123 Main St, City, Country" />
								<span asp-validation-for="Address" class="text-danger small"></span>
							</div>
						</div>

						<div class="form-group form-row">
							<label class="col-sm-4 col-form-label">Email:</label>
							<div class="col-sm-8">
								<input asp-for="Email" class="form-control" type="email" placeholder="abc@gmail.com" />
								<span asp-validation-for="Email" class="text-danger small"></span>
							</div>
						</div>

						<div class="form-group form-row">
							<label class="col-sm-4 col-form-label">Role:</label>
							<div class="col-sm-8">
								<select asp-for="Role" class="form-control">
									<option value="0">User</option>
									<option value="1">Administrator</option>
								</select>
								<span asp-validation-for="Role" class="text-danger small"></span>
							</div>
						</div>

						<div class="form-group form-row">
							<label class="col-sm-4 col-form-label">Description Image:</label>
							<div class="col-sm-8">
								@if (!string.IsNullOrEmpty(Model.ImageUrl))
								{
									<div class="custom-file d-flex mb-2">
											<span class="mr-2">@Model.ImageUrl</span>
											<input asp-for="ImageUrl" class="custom-file-input" id="customFile" type="file">
									</div>
										<span asp-validation-for="ImageUrl" class="text-danger small"></span>
										<img src="@Model.ImageUrl" alt="Current Image" class="img-thumbnail" style="max-height: 150px;" />
								}
								else
								{
									<div class="custom-file mb-2">
											<input asp-for="ImageUrl" class="custom-file-input" id="customFile" type="file">
									</div>
										<span asp-validation-for="ImageUrl" class="text-danger small"></span>
									<div class="img-thumbnail" style="width:150px; height:150px; display:flex; align-items:center; justify-content:center; background-color:#f8f9fa; border:1px solid #ddd;">
										<span style="color:#666; font-size:14px;">150px x 150px</span>
									</div>
								}
							</div>
						</div>

						<!-- Nút hành động -->
				<div class="form-group text-center mt-4">
					<button type="submit" class="btn btn-success px-4">
						Update User
					</button>
					<a asp-action="Clients" asp-controller="Admin" class="btn btn-filter ml-2" style="height: 40px">
						Back to list
					</a>
				</div>
			</form>
		</div>
	</div>
</div>

@section Scripts {
	@{
		await Html.RenderPartialAsync("_ValidationScriptsPartial");
	}
}