@model IEnumerable<HKShop.DTOs.InvoiceDetailDto>
@{
	Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
	ViewBag.Title = "Detail Invoice";
}
<div>
	<div class="table-responsive">
		<table class="table">
			<thead>
				<tr>
					<th scope="col">Description Image</th>
					<th scope="col">Product Name</th>
					<th scope="col">Price</th>
					<th scope="col">Quantity</th>
					<th scope="col">Total</th>
				</tr>
			</thead>
			<tbody>	
				@foreach (var item in Model)
				{
					<tr>
						<th scope="row">
							<div class="d-flex align-items-center">
								<img src="@item.ProductImage" class="img-fluid me-5 rounded-circle" style="width: 80px; height: 80px;" alt="@item.ProductName">
							</div>
						</th>
						<td>
							<p class="mb-0 mt-4">
								<a asp-action="Detail" asp-controller="Product" asp-route-id="@item.ProductId">
									@item.ProductName
								</a>
							</p>
						</td>
						<td>
							<p class="mb-0 mt-4">@item.Price.ToString("N0") $</p>
						</td>
						<td>
							<p class="mb-0 mt-4">@item.Quantity</p>
						</td>
						<td>
							<p class="mb-0 mt-4">@item.TotalAmount.ToString("N0") $</p>
						</td>
					</tr>
				}
			</tbody>
		</table>
	</div>

	<div class="cart-summary bg-light border-top p-3 mb-2">
		<div class="container">
			<div class="flex-center">
				<!-- Thông tin tổng -->
				<div class="col-md-4 col-sm-6 d-flex justify-content-between align-items-center mt-2">
					<span class="fw-bold me-2 text-xl">Sum of money: </span>
					<span class="text-xl"> @Model.Sum(p => p.TotalAmount).ToString("N0") $</span>
				</div>

				<!-- Phí vận chuyển -->
				<div class="col-md-4 col-sm-6 d-flex justify-content-between align-items-center mt-2">
					<span class="fw-bold me-2 text-xl">Shipping Fee: </span>
					<span class="text-xl"> 0 $</span>
				</div>

				<!-- Tổng thanh toán -->
				<div class="col-md-4 col-sm-6 d-flex justify-content-between align-items-center mt-2">
					<span class="fw-bold me-2 text-xl" style="color:#D10024">Total Payment: </span>
					<span class="text-xl" style="color:#D10024;"> @Model.Sum(p => p.TotalAmount).ToString("N0") $</span>
				</div>
			</div>
		</div>
		<div class="mt-4">
			<form asp-action="Confirm" asp-controller="Orders" method="post" class="form">
				<input type="hidden" name="id" value="@Model.First().InvoiceId" />
				<div class="w-50">
					<label for="deliveryDate" class="form-label fw-medium">Delivery Date</label>
					<input type="date" class="form-control" id="deliveryDate" name="deliveryDate" required min="@DateTime.Now.ToString("yyyy-MM-dd")">
				</div>
				<div class="w-50">
					<button type="submit" class="btn btn-success px-4 py-2">
						Confirm Order
					</button>
				</div>
			</form>
		</div>
	</div>
</div>