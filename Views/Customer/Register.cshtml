@model HKShop.DTOs.RegisterRequestDto
@{
	ViewData["Title"] = "Đăng ký";
}

<div class="container-fluid py-5">
	<div class="container py-5">
    <h1 class="mb-4 mt-4 text-center" style="color: #D10024;">@UIConstants.Auth.RegisterTitle</h1>
        <form asp-action="DangKy" enctype="multipart/form-data" asp-controller="KhachHang">
            <div class="row">
                <div class="col-md-12 col-lg-6">
                    <div class="form-item w-90">
                        <label asp-for="@Model.Username" class="form-label my-3"></label><sup>*</sup>
                        <input asp-for="@Model.Username" class="form-control">
                        <span asp-validation-for="@Model.Username" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-md-12 col-lg-6">
                    <div class="form-item w-90">
                        <label asp-for="@Model.Password" class="form-label my-3"></label><sup>*</sup>
                        <input asp-for="@Model.Password" class="form-control">
                        <span asp-validation-for="@Model.Password" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-12">
                    <div class="form-item">
                        <label class="form-label my-3" asp-for="@Model.FullName"></label><sup>*</sup>
                        <input asp-for="@Model.FullName" class="form-control">
                        <span asp-validation-for="@Model.FullName" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <!-- Giới tính và Ngày sinh cùng hàng -->
            <div class="row align-items-center">
                <div class="col-md-6">
                    <label class="form-label my-3">@UIConstants.Auth.Gender</label><sup>*</sup>
                    <div class="d-flex align-items-center gap-1">
                        <div class="form-check me-3">
                            <input class="form-check-input" type="radio" asp-for="@Model.Gender" value="true" id="Nam">
                            <label class="form-check-label" for="Nam">@UIConstants.Auth.Male</label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="radio" asp-for="@Model.Gender" value="false" id="Nu">
                            <label class="form-check-label" for="Nu">@UIConstants.Auth.Female</label>
                        </div>
                    </div>
                    <span asp-validation-for="@Model.Gender" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <div class="form-item">
                        <label class="form-label my-3" asp-for="@Model.BirthDate"></label><sup>*</sup>
                        <input asp-for="@Model.BirthDate" class="form-control" type="date">
                        <span asp-validation-for="@Model.BirthDate" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-12">
                    <div class="form-item">
                        <label class="form-label my-3" asp-for="@Model.Address"></label><sup>*</sup>
                        <input asp-for="@Model.Address" class="form-control">
                        <span asp-validation-for="@Model.Address" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <!-- Điện thoại và Email cùng hàng -->
            <div class="row">
                <div class="col-md-6">
                    <div class="form-item">
                        <label class="form-label my-3" asp-for="@Model.PhoneNumber"></label><sup>*</sup>
                        <input asp-for="@Model.PhoneNumber" class="form-control">
                        <span asp-validation-for="@Model.PhoneNumber" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-item">
                        <label class="form-label my-3" asp-for="@Model.Email"></label><sup>*</sup>
                        <input asp-for="@Model.Email" class="form-control">
                        <span asp-validation-for="@Model.Email" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-12">
                    <div class="form-item">
                        <label class="form-label my-3" for="Hinh">@UIConstants.Auth.ImageLabel</label><sup>*</sup>
                        <input type="file" name="hinh" class="form-control">
                    </div>
                </div>
            </div>

            <div class="row g-4 text-center align-items-center justify-content-center pt-4 mt-4">
                <button type="submit" class="btn border-primary border-hover-primary py-3 px-4 text-uppercase my-3 w-60">@UIConstants.Auth.RegisterButton</button>
            </div>
        </form>
	</div>
</div>

