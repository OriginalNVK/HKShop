@model IEnumerable<HKShop.DTOs.CartItemDto>
@{
	ViewData["Title"] = "Giỏ Hàng";
}

<!-- Cart Page Start -->
<div class="container-fluid py-5">
	<div class="container py-5">
		<div class="table-responsive">
			<table class="table">
				<thead>
					<tr>
						<th scope="col">Description Image</th>
						<th scope="col">Product Name</th>
						<th scope="col">Price</th>
						<th scope="col">Quantity</th>
						<th scope="col">Total</th>
						<th scope="col">Remove Product</th>
					</tr>
				</thead>
				<tbody>
					@foreach (var item in Model)
					{
						<tr>
							<th scope="row">
								<div class="d-flex align-items-center">
									<img src="@item.ImageUrl" class="img-fluid me-5 rounded-circle" style="width: 80px; height: 80px;" alt="@item.ProductName">
								</div>
							</th>
							<td>
								<p class="mb-0 mt-4">
									<a asp-action="Detail" asp-controller="Product" asp-route-id="@item.ProductId">
										@item.ProductName
									</a>
								</p>
							</td>
							<td>
								<p class="mb-0 mt-4">@item.Price $</p>
							</td>
							<td>
								<div class="input-group quantity mt-3" style="width: 100px;">
									<div class="input-group-btn">
										<button class="btn btn-sm btn-minus rounded-circle bg-light border" type="button">
											<i class="fa fa-minus"></i>
										</button>
									</div>
									<input type="text" class="form-control form-control-sm text-center border-0" value="@item.Quantity">
									<div class="input-group-btn">
										<button class="btn btn-sm btn-plus rounded-circle bg-light border" type="button">
											<i class="fa fa-plus"></i>
										</button>
									</div>
								</div>
							</td>
							<td>
								<p class="mb-0 mt-4">@item.LineTotal $</p>
							</td>
							<td>
								<a asp-action="RemoveCart" asp-controller="Cart" asp-route-id="@item.ProductId" class="btn btn-md rounded-circle bg-light border mt-3">
									<i class="fa fa-times text-danger text-2xl"></i>
								</a>
							</td>

						</tr>
					}
				</tbody>
			</table>
		</div>
		<div class="cart-summary fixed-bottom bg-light border-top p-3 mb-2">
			<div class="container">
				<div class="row align-items-center d-flex justify-center">
					<!-- Apply Coupon -->
					<div class="col-md-4 col-sm-6 d-flex align-items-center gap-1">
						<button class="btn border-secondary rounded-pill py-1 text-primary" type="button">Apply Coupon</button>
						<input type="text" class="form-control border-0 border-bottom ms-2" placeholder="Discount Code">
					</div>
					<!-- Subtotal -->
					<div class="col-md-2 col-sm-6 d-flex justify-content-between align-items-center mt-2 gap-1">
						<span class="fw-bold me-2 text-xl">Original Price: </span>
						<span class="text-xl"> $@Model.Sum(p => p.LineTotal)</span>
					</div>
					<!-- Shipping -->
					<div class="col-md-2 col-sm-6 d-flex justify-content-between align-items-center mt-2 gap-1">
						<span class="fw-bold me-2 text-xl">Shipping Fee: </span>
						<span class="text-xl"> $00</span>
					</div>
					<!-- Total (Bigger) -->
					<div class="col-md-2 col-sm-6 d-flex justify-content-between align-items-center mt-1 gap-1">
						<span class="fw-bold me-2 text-2xl" style="color:#D10024">Total: </span>
						<span class="text-2xl" style="color:#D10024;"> $@Model.Sum(p => p.LineTotal)</span>
					</div>
					<div class="col-md-2 col-sm-6 d-flex justify-content-between align-items-center">
						<a class="btn bg-red rounded-pill px-4 py-2 text-uppercase w-100" asp-action="Checkout" asp-controller="Cart">Mua hàng</a>
					</div>
				</div>
			</div>
		</div>
	</div>
</div>
<!-- Cart Page End -->
